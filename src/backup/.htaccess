# .htaccess file - website ke root folder mein daal de

RewriteEngine On

# HTTP se HTTPS redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www se non-www redirect (agar chahiye)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# Purane domain se naye domain pe redirect
RewriteCond %{HTTP_HOST} ^olddomain\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.olddomain\.com$ [NC]
RewriteRule ^(.*)$ https://newdomain.com/$1 [L,R=301]

# Specific page redirect
Redirect 301 /old-page.html https://yoursite.com/new-page
Redirect 301 /old-folder/ https://yoursite.com/new-folder/